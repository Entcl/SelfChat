{
  "name": "s-c",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"npm run dev\" \"cross-env NODE_ENV=development wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win zip && node build/finalize-release.cjs"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^13.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "@electron/asar": {
      "minimatch": "^3.1.5"
    },
    "dir-compare": {
      "minimatch": "^3.1.5"
    },
    "glob": {
      "minimatch": "^3.1.5"
    },
    "filelist": {
      "minimatch": "^5.1.9"
    }
  },
  "build": {
    "appId": "com.selfchat.app",
    "productName": "SelfChat",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "build/icon.png",
      "!server/data.sqlite",
      "!server/plugins_config.json",
      "!server/plugins_data/**/*",
      "!server/temp_uploads/**/*",
      "!server/node_modules/**/*",
      "!**/*.log",
      "!**/.venv/**/*",
      "!**/__pycache__/**/*"
    ],
    "extraFiles": [
      {
        "from": "build/使用说明.txt",
        "to": "使用说明.txt"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-win-x64.${ext}",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
